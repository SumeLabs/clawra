{
  "name": "clawra",
  "version": "1.1.1",
  "description": "Add selfie superpowers to your OpenClaw agent using Qwen Image, Grok Imagine, Google nano-banana, Hunyuan and more",
  "bin": {
    "clawra": "./bin/cli.js"
  },
  "scripts": {
    "clawra": "ts-node scripts/clawra-selfie.ts",
    "list-models": "ts-node scripts/clawra-selfie.ts --list-models",
    "test": "node --test tests/**/*.test.js",
    "test:live": "node scripts/live-platform-test.js"
  },
  "files": [
    "bin/",
    "skill/",
    "templates/",
    "SKILL.md",
    "scripts/",
    "assets/"
  ],
  "keywords": [
    "openclaw",
    "grok",
    "imagine",
    "xai",
    "aurora",
    "fal.ai",
    "qwen",
    "dashscope",
    "hunyuan",
    "google",
    "gemini",
    "seedream",
    "volcengine",
    "selfie",
    "ai-agent",
    "image-generation",
    "messaging"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SumeLabs/clawra"
  },
  "homepage": "https://github.com/SumeLabs/clawra#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "tencentcloud-sdk-nodejs": "^4.1.186"
  },
  "devDependencies": {
    "@fal-ai/client": "^1.2.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
